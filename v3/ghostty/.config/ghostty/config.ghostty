# Ghostty baseline for Arch Linux + GNOME.
theme = Gruvbox Dark
selection-background = #504945
selection-foreground = #ebdbb2

font-family = MesloLGS Nerd Font Mono
font-size = 11

window-padding-x = 10
window-padding-y = 10
background-opacity = 0.9
background-blur = true

# Compatible with SSH hosts that do not have Ghostty terminfo.
term = xterm-256color

bell-features = audio,attention,title,no-system,no-border
bell-audio-path = /usr/share/sounds/freedesktop/stereo/bell.oga

# Slim, Gruvbox-coloured header bar.
gtk-titlebar = true
window-theme = ghostty
gtk-toolbar-style = flat
window-titlebar-background = #d79921
window-titlebar-foreground = #282828
gtk-custom-css = slim-titlebar.css
